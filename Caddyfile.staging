# ═══════════════════════════════════════════════════════════════
#  linqoy — Staging Docker Caddy (internal proxy only)
#  Host-level Caddy handles TLS, domains, and redirects separately.
# ═══════════════════════════════════════════════════════════════

:80 {
  # File downloads + uploads — always go to API
  handle /file/* {
    reverse_proxy api:3000 {
      flush_interval -1
    }
  }
  handle /upload* {
    reverse_proxy api:3000 {
      transport http {
        read_timeout 300s
        write_timeout 300s
      }
    }
  }
  handle /sharex/* {
    reverse_proxy api:3000
  }
  handle /health* {
    reverse_proxy api:3000
  }

  # API routes — only for fetch() calls (JSON), not browser page loads
  @apiCall {
    header Accept application/json
  }
  handle @apiCall {
    reverse_proxy api:3000
  }

  # Everything else → Next.js frontend
  reverse_proxy web:3000
}
